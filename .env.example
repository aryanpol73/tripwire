# Copy to .env and fill in. Never commit .env.

# Phase 6 only: the LLM explorer. The model name is read from here, never hard-coded.
# It must be listed in src/tripwire/llm/prices.toml (or set TRIPWIRE_PRICE_IN/OUT in US$
# per million tokens), otherwise the spend cap cannot be enforced and the run refuses.
# Provider: anthropic, groq or cloudflare. If unset, the one whose key is filled in is used.
TRIPWIRE_PROVIDER=
TRIPWIRE_MODEL=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Several hosts serving the same open-weights model can split one eval (D-070), e.g.
#   TRIPWIRE_HOSTS=groq,cloudflare
# Each host names the same model under its own id. One account per host, used within that
# host's own free tier or plan; never several accounts at one host.
TRIPWIRE_HOSTS=
GROQ_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# For gpt-oss-120b on Workers AI: @cf/openai/gpt-oss-120b
CLOUDFLARE_MODEL=
# Optional: low | medium | high | xhigh | max. Empty uses the model's default.
TRIPWIRE_EFFORT=

# Hard budgets per run (ETHICS rule 8). The run aborts cleanly when any is exceeded.
TRIPWIRE_MAX_STEPS=60
TRIPWIRE_MAX_SECONDS=300
TRIPWIRE_MAX_PAGE_LOADS=30
TRIPWIRE_MAX_LLM_USD=0.50

# Politeness (ETHICS rule 5): minimum seconds between actions.
TRIPWIRE_MIN_ACTION_INTERVAL_S=2
