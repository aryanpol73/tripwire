{
  "schema_version": "0.1.0",
  "scenario_id": "wire-clean-skin1",
  "family": "wire",
  "state": "clean",
  "skin": 1,
  "site_type": "saas",
  "mission": "sign_up_and_leave",
  "expectations": [
    {
      "rule": "consent.click_asymmetry",
      "family": "consent_asymmetry",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "accept_clicks": 1,
        "reject_clicks": 1,
        "extra_clicks_to_reject": 0,
        "reject_on_first_layer": true
      }
    },
    {
      "rule": "consent.visual_asymmetry",
      "family": "consent_asymmetry",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "compared_on_layer": 1,
        "area_ratio": 1.0,
        "accept_contrast": 6.82,
        "reject_contrast": 6.82,
        "accept_font_px": 16,
        "reject_font_px": 16
      }
    },
    {
      "rule": "consent.preselected",
      "family": "consent_asymmetry",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "preselected_count": 0
      }
    },
    {
      "rule": "consent.confirmshaming",
      "family": "consent_asymmetry",
      "tier": "B",
      "should_fire": false,
      "metrics": {
        "decline_text": "Reject all"
      }
    },
    {
      "rule": "sneaking.price_drift",
      "family": "sneaking",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "advertised_total_minor": 79900,
        "final_total_minor": 79900,
        "drift_from_mandatory_minor": 0,
        "late_mandatory_lines": 0,
        "currency": "INR"
      }
    },
    {
      "rule": "sneaking.preadded_extras",
      "family": "sneaking",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "preadded_count": 0,
        "preadded_minor": 0
      }
    },
    {
      "rule": "sneaking.bundled_optins",
      "family": "sneaking",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "hidden_optin_count": 0,
        "unclassified_enabled_hidden_fields": 0
      }
    },
    {
      "rule": "sneaking.renewal_disclosure",
      "family": "sneaking",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "renewal_date_shown": true,
        "renewal_font_px": 16,
        "renewal_contrast": 18.88
      }
    },
    {
      "rule": "obstruction.roach_motel",
      "family": "obstruction",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "sign_up_clicks": 3,
        "leave_clicks": 4,
        "extra_clicks_to_leave": 1,
        "exit_channel": "web"
      }
    },
    {
      "rule": "obstruction.buried_control",
      "family": "obstruction",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "footer_only": false,
        "click_depth": 0,
        "font_px": 16,
        "contrast": 18.88
      }
    },
    {
      "rule": "obstruction.interposed_friction",
      "family": "obstruction",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "unneeded_interstitials": 0
      }
    },
    {
      "rule": "wire.flipped_choice",
      "family": "wire",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "flipped_count": 0,
        "flipped_fields": ""
      }
    },
    {
      "rule": "wire.injected_optin",
      "family": "wire",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "injected_optin_count": 0,
        "injected_fields": "",
        "unclassified_added_fields": 0
      }
    }
  ],
  "decoys": [
    {
      "id": "locked_necessary_toggle",
      "description": "A 'strictly necessary' toggle that is on and cannot be changed.",
      "must_not_trigger": [
        "consent.preselected"
      ]
    },
    {
      "id": "equal_weight_buttons",
      "description": "Accept and Reject on the first layer with identical size and colour.",
      "must_not_trigger": [
        "consent.click_asymmetry",
        "consent.visual_asymmetry"
      ]
    },
    {
      "id": "optional_toggles_unchecked",
      "description": "A settings layer whose optional toggles are all off.",
      "must_not_trigger": [
        "consent.preselected"
      ]
    },
    {
      "id": "csrf_hidden_input",
      "description": "A hidden CSRF token in the sign-up form.",
      "must_not_trigger": [
        "sneaking.bundled_optins"
      ]
    },
    {
      "id": "remember_me_prechecked",
      "description": "A visible, pre-checked 'Remember me on this device' box.",
      "must_not_trigger": [
        "sneaking.bundled_optins"
      ]
    },
    {
      "id": "renewal_clearly_disclosed",
      "description": "Renewal price and date shown at 16 px in body-text colour.",
      "must_not_trigger": [
        "sneaking.renewal_disclosure"
      ]
    },
    {
      "id": "addon_offered_unchecked",
      "description": "A paid priority-support add-on offered but left unchecked.",
      "must_not_trigger": [
        "sneaking.preadded_extras"
      ]
    },
    {
      "id": "single_confirmation",
      "description": "One confirmation step before leaving.",
      "must_not_trigger": [
        "obstruction.interposed_friction",
        "obstruction.roach_motel"
      ]
    },
    {
      "id": "leave_control_as_prominent_as_join",
      "description": "The leave control sits in the main menu with normal size and colour.",
      "must_not_trigger": [
        "obstruction.buried_control"
      ]
    },
    {
      "id": "required_notice_step",
      "description": "A data-retention notice that needs an acknowledgement tick.",
      "must_not_trigger": [
        "obstruction.interposed_friction"
      ]
    },
    {
      "id": "nonce_added_at_submit",
      "description": "A security nonce added by script at submit, and an unticked box that is sent as unticked.",
      "must_not_trigger": [
        "wire.flipped_choice",
        "wire.injected_optin"
      ]
    }
  ],
  "notes": [
    "Clicks count activated controls (buttons, links, checkboxes); typing is not a click.",
    "Money is integer paise (INR). Contrast ratios are WCAG 2.x, rounded to 2 decimals.",
    "reach_payment adds the cheapest item (NOTE-03, qty 1) and stops before payment.",
    "sign_up joins from the landing page; leave_clicks start on the account or home page."
  ]
}
