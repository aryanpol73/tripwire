{
  "schema_version": "0.1.0",
  "scenario_id": "obstruction-subtle-skin4",
  "family": "obstruction",
  "state": "subtle",
  "skin": 4,
  "site_type": "news",
  "mission": "sign_up_and_leave",
  "expectations": [
    {
      "rule": "consent.click_asymmetry",
      "family": "consent_asymmetry",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "accept_clicks": 1,
        "reject_clicks": 1,
        "extra_clicks_to_reject": 0,
        "reject_on_first_layer": true
      }
    },
    {
      "rule": "consent.visual_asymmetry",
      "family": "consent_asymmetry",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "compared_on_layer": 1,
        "area_ratio": 1.0,
        "accept_contrast": 17.85,
        "reject_contrast": 17.85,
        "accept_font_px": 16,
        "reject_font_px": 16
      }
    },
    {
      "rule": "consent.preselected",
      "family": "consent_asymmetry",
      "tier": "A",
      "should_fire": false,
      "metrics": {
        "preselected_count": 0
      }
    },
    {
      "rule": "consent.confirmshaming",
      "family": "consent_asymmetry",
      "tier": "B",
      "should_fire": false,
      "metrics": {
        "decline_text": "Only necessary"
      }
    },
    {
      "rule": "obstruction.roach_motel",
      "family": "obstruction",
      "tier": "A",
      "should_fire": true,
      "metrics": {
        "sign_up_clicks": 1,
        "leave_clicks": 4,
        "extra_clicks_to_leave": 3,
        "exit_channel": "web"
      }
    },
    {
      "rule": "obstruction.buried_control",
      "family": "obstruction",
      "tier": "A",
      "should_fire": true,
      "metrics": {
        "footer_only": true,
        "click_depth": 0,
        "font_px": 13,
        "contrast": 16.3
      }
    },
    {
      "rule": "obstruction.interposed_friction",
      "family": "obstruction",
      "tier": "A",
      "should_fire": true,
      "metrics": {
        "unneeded_interstitials": 2
      }
    }
  ],
  "decoys": [
    {
      "id": "locked_necessary_toggle",
      "description": "A 'strictly necessary' toggle that is on and cannot be changed.",
      "must_not_trigger": [
        "consent.preselected"
      ]
    },
    {
      "id": "equal_weight_buttons",
      "description": "Accept and Reject on the first layer with identical size and colour.",
      "must_not_trigger": [
        "consent.click_asymmetry",
        "consent.visual_asymmetry"
      ]
    },
    {
      "id": "optional_toggles_unchecked",
      "description": "A settings layer whose optional toggles are all off.",
      "must_not_trigger": [
        "consent.preselected"
      ]
    }
  ],
  "notes": [
    "Clicks count activated controls (buttons, links, checkboxes); typing is not a click.",
    "Money is integer paise (INR). Contrast ratios are WCAG 2.x, rounded to 2 decimals.",
    "reach_payment adds the cheapest item (NOTE-03, qty 1) and stops on the payment page.",
    "sign_up joins from the landing page; leave_clicks start on the account or home page."
  ]
}
